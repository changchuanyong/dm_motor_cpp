@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(fmt)
find_dependency(spdlog)
find_dependency(Boost COMPONENTS system)

include("${CMAKE_CURRENT_LIST_DIR}/motorsTargets.cmake")

if(NOT TARGET motors::motors_all)
    add_library(motors::motors_all INTERFACE IMPORTED)
    target_link_libraries(motors::motors_all INTERFACE 
        motors::motors
        motors::dm_motors
        motors::motors_can
        motors::motors_canfd
    )
endif()

check_required_components(motors)
